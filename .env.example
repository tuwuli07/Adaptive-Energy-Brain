# Local Windows-only paths are generated by scripts/setup_windows_storage.ps1
# into the ignored .env.storage file. Never add machine-specific absolute paths
# or credentials to this shared template.
AEB_STORAGE_ROOT=
AEB_DATA_ROOT=
AEB_SPLIT_ROOT=
AEB_EXPERIMENTS_ROOT=
AEB_CHECKPOINTS_ROOT=
PIP_CACHE_DIR=
TORCH_HOME=
HF_HOME=
MPLCONFIGDIR=
TMP=
TEMP=
PYTHONPYCACHEPREFIX=
COVERAGE_FILE=
# The energy assistant always uses Gemini. Configure GEMINI_API_KEY on the backend.
ENERGY_ASSISTANT_PROVIDER=gemini
# For hosted Gemini access, configure both secrets on the server. Generate a
# random access key of at least 32 characters; never put either secret in frontend code.
# ENERGY_ASSISTANT_ACCESS_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ENERGY_DATASET_STORAGE=absolute path to a private persistent mounted directory
