# Local Windows-only paths are generated by scripts/setup_windows_storage.ps1
# into the ignored .env.storage file. Never add machine-specific absolute paths
# or credentials to this shared template.
AEB_STORAGE_ROOT=
AEB_DATA_ROOT=
AEB_SPLIT_ROOT=
AEB_EXPERIMENTS_ROOT=
AEB_CHECKPOINTS_ROOT=
PIP_CACHE_DIR=
TORCH_HOME=
HF_HOME=
MPLCONFIGDIR=
TMP=
TEMP=
PYTHONPYCACHEPREFIX=
COVERAGE_FILE=
# Assistant provider: local Ollama by default; Gemini remains opt-in.
ENERGY_ASSISTANT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ENERGY_DATASET_STORAGE=absolute path to a private persistent mounted directory
# 0 uses CPU (reliable on systems with slow GPU startup); -1 enables automatic offload.
OLLAMA_NUM_GPU=0
