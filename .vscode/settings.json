{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.envFile": "${workspaceFolder}\\.env.storage",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.profiles.windows": {
    "PowerShell (Adaptive Energy Brain storage)": {
      "path": "${env:WINDIR}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoExit",
        "-Command",
        ". .\\scripts\\setup_windows_storage.ps1"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell (Adaptive Energy Brain storage)"
}
